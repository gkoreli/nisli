{
  "name": "@nisli/www",
  "version": "0.0.0",
  "private": true,
  "description": "The nisli website — home, docs, design showcase, and component gallery, rendered static by @nisli/ssg.",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "sync": "pnpm --filter @nisli/ui build && node scripts/sync.mjs",
    "render": "vitest run src/render.test.ts",
    "build": "pnpm run sync && pnpm run render && tailwindcss -i src/styles/input.css -o dist/assets/site.css --minify && pnpm run build:hydrate",
    "build:hydrate": "vite build --config vite.hydrate.config.ts",
    "test:previews": "node scripts/preview-sweep.mjs",
    "proof:message-layout": "node scripts/message-layout-proof.mjs",
    "proof:message-layout:cleanup": "node scripts/message-layout-proof.mjs --self-test-cleanup",
    "proof:animations": "node scripts/animation-proof.mjs",
    "proof:movebefore": "node scripts/movebefore-proof.mjs",
    "proof:router-navigation": "node scripts/router-navigation-proof.mjs",
    "proof:router-navigation:vacuity": "node scripts/router-navigation-proof.mjs --self-test-vacuity",
    "proof:view-transitions": "node scripts/view-transition-proof.mjs",
    "release": "pnpm run build && npx wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "measure:projection": "node scripts/projection-cost.mjs"
  },
  "devDependencies": {
    "@nisli/core": "workspace:*",
    "@nisli/router": "workspace:*",
    "@nisli/ssg": "workspace:*",
    "@nisli/ui": "workspace:*",
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "playwright": "1.61.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.1.5"
  }
}
