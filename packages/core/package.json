{
  "name": "@nisli/core",
  "version": "0.57.0",
  "description": "A reactive web component framework. Signals, templates, dependency injection \u2014 no build step, no virtual DOM, no dependencies.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gkoreli/nisli.git",
    "directory": "packages/core"
  },
  "keywords": [
    "web-components",
    "signals",
    "reactive",
    "framework",
    "template-literals",
    "dependency-injection"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./vite-hmr": "./src/vite-hmr/plugin.ts",
    "./vite-hmr/runtime": "./src/vite-hmr/runtime.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/bundler/index.js"
      },
      "./vite-hmr": {
        "types": "./dist/types/vite-hmr/plugin.d.ts",
        "default": "./dist/bundler/vite-hmr/plugin.js"
      },
      "./vite-hmr/runtime": {
        "types": "./dist/types/vite-hmr/runtime.d.ts",
        "default": "./dist/bundler/vite-hmr/runtime.js"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.28.1",
    "vite": "7.3.6"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:package": "node scripts/proof-package.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  }
}
