{
  "name": "@nisli/core",
  "version": "0.49.1",
  "description": "A reactive web component framework. Signals, templates, dependency injection — no build step, no virtual DOM, no dependencies.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gkoreli/nisli.git",
    "directory": "packages/core"
  },
  "keywords": [
    "web-components",
    "signals",
    "reactive",
    "framework",
    "template-literals",
    "dependency-injection"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./esbuild-hmr": "./src/esbuild-hmr/plugin.ts",
    "./esbuild-hmr/runtime": "./src/esbuild-hmr/runtime.ts",
    "./esbuild-hmr/server": "./src/esbuild-hmr/server.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./esbuild-hmr": {
        "types": "./dist/esbuild-hmr/plugin.d.ts",
        "default": "./dist/esbuild-hmr/plugin.js"
      },
      "./esbuild-hmr/runtime": {
        "types": "./dist/esbuild-hmr/runtime.d.ts",
        "default": "./dist/esbuild-hmr/runtime.js"
      },
      "./esbuild-hmr/server": {
        "types": "./dist/esbuild-hmr/server.d.ts",
        "default": "./dist/esbuild-hmr/server.js"
      }
    }
  },
  "peerDependencies": {
    "esbuild": "*"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  }
}
