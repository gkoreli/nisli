{
  "name": "@nisli/ui",
  "version": "0.3.0",
  "description": "shadcn-style component registry and CLI for the Nisli web component framework. Components are copied into your project as source you own.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gkoreli/nisli.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "nisli",
    "web-components",
    "components",
    "design-system",
    "shadcn",
    "tailwind",
    "registry"
  ],
  "bin": {
    "nisli-ui": "./dist/cli.js"
  },
  "peerDependencies": {
    "@nisli/core": ">=0.53.0"
  },
  "devDependencies": {
    "@nisli/core": "workspace:*",
    "@nisli/ssg": "workspace:*",
    "tw-animate-css": "^1.4.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "registry",
    "!registry/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "e2e:pack": "pnpm build && node scripts/pack-e2e.mjs",
    "e2e:npm": "node scripts/npm-e2e.mjs",
    "e2e:theme": "node scripts/theme-e2e.mjs",
    "e2e:theme:cleanup": "node scripts/theme-e2e.mjs --self-test-cleanup",
    "e2e:button-group": "node scripts/button-group-e2e.mjs",
    "e2e:button-group:cleanup": "node scripts/button-group-e2e.mjs --self-test-cleanup",
    "e2e:positional-host": "node scripts/positional-host-e2e.mjs",
    "e2e:positional-host:cleanup": "node scripts/positional-host-e2e.mjs --self-test-cleanup",
    "e2e:toast-row": "node scripts/toast-row-e2e.mjs",
    "e2e:toast-row:cleanup": "node scripts/toast-row-e2e.mjs --self-test-cleanup",
    "e2e:context-touch": "node scripts/context-menu-touch-e2e.mjs",
    "e2e:context-touch:cleanup": "node scripts/context-menu-touch-e2e.mjs --self-test-cleanup",
    "e2e:carousel-touch": "node scripts/carousel-touch-e2e.mjs",
    "e2e:carousel-touch:cleanup": "node scripts/carousel-touch-e2e.mjs --self-test-cleanup",
    "e2e:message-scroller": "node scripts/message-scroller-e2e.mjs",
    "e2e:message-scroller:cleanup": "node scripts/message-scroller-e2e.mjs --self-test-cleanup"
  }
}
