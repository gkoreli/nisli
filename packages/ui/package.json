{
  "name": "@nisli/ui",
  "version": "0.1.0",
  "description": "shadcn-style component registry and CLI for the Nisli web component framework. Components are copied into your project as source you own.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gkoreli/nisli.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "nisli",
    "web-components",
    "components",
    "design-system",
    "shadcn",
    "tailwind",
    "registry"
  ],
  "bin": {
    "nisli-ui": "./dist/cli.js"
  },
  "peerDependencies": {
    "@nisli/core": ">=0.48.0"
  },
  "devDependencies": {
    "@nisli/core": "workspace:*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "registry",
    "!registry/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  }
}
