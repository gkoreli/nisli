# Copy to .env (git-ignored), chmod 600, and replace values locally.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Add after Tailscale HTTPS is configured, for example:
# PLAID_REDIRECT_URI=https://ledger-machine.random-tailnet.ts.net/connections
PLAID_REDIRECT_URI=

# Generate locally with: openssl rand -hex 32
LEDGER_KEY=
LEDGER_SYNC_HOUR=6
